    box-shadow: 0.2rem 0 0.6rem rgba(0, 0, 0, 0.3)
nav.toc-panel div.toc-tab
    position: absolute
    top: 13.89rem
    left: calc(100% - 1px)
    padding: 0.9rem 0.35rem
    line-height: 0
