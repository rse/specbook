nav.toc-panel li > a.active
    background-color: var(--theme-color-specbook-tint-stripe)
nav.toc-panel li > a.anchored
    background-color: var(--theme-color-specbook-tint-deep)
nav.toc-panel li > a::after
    flex: none
    margin-left: auto
    padding-left: 0.4rem
    white-space: nowrap
    color: var(--theme-color-specbook-accent)
    font-size: 110%
    line-height: 0
    position: relative
    top: 0.05em
    font-family: "Source Sans 3", "Noto Sans Symbols", sans-serif
    -webkit-user-select: none
    user-select: none
nav.toc-panel li > a.active::after
    content: "\25C0"
nav.toc-panel li > a.anchored::after
    content: "\2693\FE0E"
nav.toc-panel li > a.active.anchored::after
    content: "\25C0\00A0\2693\FE0E"
nav.toc-panel li > a::before
    content: counters(item, ".", decimal-leading-zero)
    flex: none
    color: var(--theme-color-specbook-muted)
    margin-right: 0.4rem
nav.toc-panel ul ul ul ul li > a::before,
nav.toc-panel ul.extra li > a::before
    content: none
nav.toc-panel a
    color: var(--theme-color-specbook-text)

/*  the front matter entries ("Title", "Table of Contents", and
    "Diagram of Contents") render in the accent color, matching the
