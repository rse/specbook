/*  emit standard CSS at-rules only (no legacy vendor prefixes)  */
vendors = official

/*  Adobe Source Sans 3 font faces  */
@font-face
    font-family: "Source Sans 3"
    font-style: normal
    font-weight: normal
    src: url("../node_modules/source-sans/WOFF2/TTF/SourceSans3-Regular.ttf.woff2") format("woff2")
@font-face
    font-family: "Source Sans 3"
    font-style: italic
    font-weight: normal
    src: url("../node_modules/source-sans/WOFF2/TTF/SourceSans3-It.ttf.woff2") format("woff2")
@font-face
    font-family: "Source Sans 3"
    font-style: normal
    font-weight: 600
    src: url("../node_modules/source-sans/WOFF2/TTF/SourceSans3-Semibold.ttf.woff2") format("woff2")
@font-face
    font-family: "Source Sans 3"
    font-style: italic
    font-weight: 600
    src: url("../node_modules/source-sans/WOFF2/TTF/SourceSans3-SemiboldIt.ttf.woff2") format("woff2")
@font-face
    font-family: "Source Sans 3"
    font-style: normal
    font-weight: bold
    src: url("../node_modules/source-sans/WOFF2/TTF/SourceSans3-Bold.ttf.woff2") format("woff2")
@font-face
    font-family: "Source Sans 3"
    font-style: italic
    font-weight: bold
    src: url("../node_modules/source-sans/WOFF2/TTF/SourceSans3-BoldIt.ttf.woff2") format("woff2")

/*  Noto Sans Symbols font faces  */
@font-face
    font-family: "Noto Sans Symbols"
    font-style: normal
    font-weight: normal
    src: url("../node_modules/@fontsource/noto-sans-symbols/files/" + \
        "noto-sans-symbols-symbols-400-normal.woff2") format("woff2")

/*  Adobe Source Code Pro font face (regular only, as the italic
    and bold faces are intentionally not embedded)  */
@font-face
    font-family: "Source Code Pro"
    font-style: normal
    font-weight: normal
    src: url("../node_modules/source-code-pro/WOFF2/TTF/SourceCodePro-Regular.ttf.woff2") \
        format("woff2")

/*  the theme-specific (layer 2) mapping of the export-time generated
    (layer 1) color spreads --theme-color-{base,accent,search}-{1..32} onto
    the semantic colors --theme-color-specbook-XXX used by the rules below
    (layer 3), with the dark theme using roughly mirrored indices  */
html,
html.theme-light
    --theme-color-specbook-background:        var(--theme-color-base-32)
    --theme-color-specbook-text:              var(--theme-color-base-6)
    --theme-color-specbook-muted:             var(--theme-color-base-22)
    --theme-color-specbook-symbol:            var(--theme-color-base-24)
    --theme-color-specbook-border:            var(--theme-color-base-28)
    --theme-color-specbook-stripe:            var(--theme-color-base-31)
    --theme-color-specbook-tint:              var(--theme-color-accent-32)
    --theme-color-specbook-tint-stripe:       var(--theme-color-accent-30)
    --theme-color-specbook-tint-deep:         var(--theme-color-accent-28)
    --theme-color-specbook-accent:            var(--theme-color-accent-12)
    --theme-color-specbook-accent-soft:       var(--theme-color-accent-18)
    --theme-color-specbook-mark-text:         var(--theme-color-search-32)
    --theme-color-specbook-mark-back:         var(--theme-color-search-16)
    --theme-color-specbook-field:             var(--theme-color-accent-8)
    --theme-color-specbook-error:             #cc0000
    --theme-color-specbook-popup-schema-path: var(--theme-color-accent-30)
    --theme-color-specbook-popup-schema-desc: var(--theme-color-base-32)
    --theme-color-specbook-popup-spec-path:   var(--theme-color-accent-12)
    --theme-color-specbook-popup-spec-desc:   var(--theme-color-base-5)
    --theme-color-specbook-progress-done:     var(--theme-color-accent-12)
    --theme-color-specbook-progress-todo:     var(--theme-color-accent-31)
    --gradia-font-family:                     "Source Sans 3"
    --gradia-color-node-regular-name:         var(--theme-color-accent-12)
    --gradia-color-node-regular-box:          var(--theme-color-accent-30)
    --gradia-color-node-regular-border:       var(--theme-color-accent-26)
    --gradia-color-node-primary-name:         var(--theme-color-base-32)
    --gradia-color-node-primary-box:          var(--theme-color-accent-12)
    --gradia-color-node-primary-border:       var(--theme-color-accent-8)
    --gradia-color-node-ghost-name:           var(--theme-color-base-22)
    --gradia-color-node-ghost-box:            var(--theme-color-base-31)
    --gradia-color-node-ghost-border:         var(--theme-color-base-24)
    --gradia-color-group-name:                var(--theme-color-accent-18)
    --gradia-color-group-box:                 var(--theme-color-accent-32)
    --gradia-color-group-border:              var(--theme-color-accent-26)
    --gradia-color-container-name:            var(--theme-color-base-12)
    --gradia-color-container-box:             var(--theme-color-base-31)
    --gradia-color-container-border:          var(--theme-color-base-24)
    --gradia-color-edge-line:                 var(--theme-color-base-22)
    --gradia-color-edge-name:                 var(--theme-color-base-5)
    --gradia-color-edge-arity:                var(--theme-color-base-5)
    --gradia-color-edge-halo:                 var(--theme-color-specbook-background)

/*  the dark theme applies on screen only, so print (and hence the
    PDF export) always falls back onto the light mapping above  */
@media screen
    html.theme-dark
        --theme-color-specbook-background:        var(--theme-color-base-7)
        --theme-color-specbook-text:              var(--theme-color-base-29)
        --theme-color-specbook-muted:             var(--theme-color-base-22)
        --theme-color-specbook-symbol:            var(--theme-color-base-20)
        --theme-color-specbook-border:            var(--theme-color-base-16)
        --theme-color-specbook-stripe:            var(--theme-color-base-9)
        --theme-color-specbook-tint:              var(--theme-color-accent-1)
        --theme-color-specbook-tint-stripe:       var(--theme-color-accent-3)
        --theme-color-specbook-tint-deep:         var(--theme-color-accent-5)
        --theme-color-specbook-accent:            var(--theme-color-accent-24)
        --theme-color-specbook-accent-soft:       var(--theme-color-accent-16)
        --theme-color-specbook-mark-text:         var(--theme-color-search-32)
        --theme-color-specbook-mark-back:         var(--theme-color-search-4)
        --theme-color-specbook-field:             var(--theme-color-accent-16)
        --theme-color-specbook-error:             #cc0000
        --theme-color-specbook-popup-schema-path: var(--theme-color-accent-4)
        --theme-color-specbook-popup-schema-desc: var(--theme-color-base-7)
        --theme-color-specbook-popup-spec-path:   var(--theme-color-accent-24)
        --theme-color-specbook-popup-spec-desc:   var(--theme-color-base-29)
        --theme-color-specbook-progress-done:     var(--theme-color-accent-24)
        --theme-color-specbook-progress-todo:     var(--theme-color-accent-4)
        --gradia-color-node-regular-name:         var(--theme-color-accent-21)
        --gradia-color-node-regular-box:          var(--theme-color-accent-3)
        --gradia-color-node-regular-border:       var(--theme-color-accent-7)
        --gradia-color-node-primary-name:         var(--theme-color-base-1)
        --gradia-color-node-primary-box:          var(--theme-color-accent-21)
        --gradia-color-node-primary-border:       var(--theme-color-accent-25)
        --gradia-color-node-ghost-name:           var(--theme-color-base-24)
        --gradia-color-node-ghost-box:            var(--theme-color-base-12)
        --gradia-color-node-ghost-border:         var(--theme-color-base-16)
        --gradia-color-group-name:                var(--theme-color-accent-15)
        --gradia-color-group-box:                 var(--theme-color-accent-1)
        --gradia-color-group-border:              var(--theme-color-accent-7)
        --gradia-color-container-name:            var(--theme-color-base-24)
        --gradia-color-container-box:             var(--theme-color-base-4)
        --gradia-color-container-border:          var(--theme-color-base-16)
        --gradia-color-edge-line:                 var(--theme-color-base-20)
        --gradia-color-edge-name:                 var(--theme-color-base-29)
        --gradia-color-edge-arity:                var(--theme-color-base-29)
        --gradia-color-edge-halo:                 var(--theme-color-specbook-background)

html, body
    font-size: 12pt

@media print
    html, body
        font-size: 9pt

body
    font-family: "Source Sans 3", sans-serif
    max-width: 60rem
    margin: 0 auto
    padding: 2rem
    color: var(--theme-color-specbook-text)
    background-color: var(--theme-color-specbook-background)

/*  the vertical brand bar at the left edge of the viewport (for print
    the PDF export draws it onto the physical paper edge instead)  */
body::before
    content: ""
    position: fixed
    top: 0
    bottom: 0
    left: 0
    width: 0.6rem
    background-color: var(--theme-color-specbook-accent)
@media print
    body::before
        display: none
    body
        padding: 0

/*  the theme-switching tab (screen-only): the topmost tab riding right
    of the brand bar above the info tab (sized like the table of
    contents tab, fixed independent of the content scrolling), showing
    a half-filled circle icon (drawn like the search icon, mimicking
    the U+25D0 glyph), which switches the color theme, where the tab
    follows the bar when the table of contents panel shifts it aside  */
div.theme-switch
    position: fixed
    top: 0.97rem
    left: calc(0.6rem - 1px)
    z-index: 30
    padding: 0.9rem 0.35rem
    line-height: 0
    border-radius: 0 0.3rem 0.3rem 0
    color: var(--theme-color-specbook-background)
    background-color: var(--theme-color-specbook-accent)
    transition: left 0.3s ease
    cursor: pointer
    -webkit-user-select: none
    user-select: none
body:has(nav.toc-panel.open) div.theme-switch
    left: calc(31rem - 1px)
    box-shadow: 0.2rem 0 0.6rem rgba(0, 0, 0, 0.3)
div.theme-switch:hover
    background-color: var(--theme-color-specbook-accent-soft)
div.theme-switch svg.theme-icon
    width: 1.1rem
    height: 1.1rem
    margin-right: 0.15rem
@media print
    div.theme-switch
        display: none

/*  the description popup tab (screen-only): the tab riding right of
    the brand bar between the theme-switching tab and the search tab
    (sized like the search tab, fixed independent of the content
    scrolling), showing an "info" icon (drawn like the search icon),
    which toggles the description popups on and off (default), where
    the tab follows the bar when the table of contents panel shifts it
    aside and the icon carries the mark colors in a rounded box while
    the popups are enabled, signalling the active toggle  */
div.info-switch
    position: fixed
    top: 4.20rem
    left: calc(0.6rem - 1px)
    z-index: 30
    padding: 0.65rem 0.1rem
    line-height: 0
    border-radius: 0 0.3rem 0.3rem 0
    color: var(--theme-color-specbook-background)
    background-color: var(--theme-color-specbook-accent)
    transition: left 0.3s ease
    cursor: pointer
    -webkit-user-select: none
    user-select: none
body:has(nav.toc-panel.open) div.info-switch
    left: calc(31rem - 1px)
    box-shadow: 0.2rem 0 0.6rem rgba(0, 0, 0, 0.3)
div.info-switch:hover
    background-color: var(--theme-color-specbook-accent-soft)
div.info-switch svg.info-icon
    width: 1.1rem
    height: 1.1rem
    padding: 0.25rem
    border-radius: 0.3rem
    margin-right: 0.15rem
body.info-on div.info-switch svg.info-icon
    color: var(--theme-color-specbook-mark-text)
    background-color: var(--theme-color-specbook-mark-back)
@media print
    div.info-switch
        display: none

/*  the description popup (screen-only): a single shared, script-
    positioned element showing the schema description of the hovered
    object kind or property name, or the corpus description of the
    hovered object name, capped at 40% viewport width with auto
    height, attached above or below the hovered element (the side
    offering more viewport space), colored like the tabs (accent
    background) and clearly popping up the content by a drop-shadow,
    with the title carrying the object path segments (a filled circle
    icon leading each, the kinds bold in the path color and the names
    semi-bold in the description color, as in the document content,
    and a pointer separating the segments), extended for properties
    with the not-filled circle icon and the bold property name, and
    the description led by a "Schema" or "Specification" origin label
    (its word in normal weight in a rounded box filled with the path
    color), where
    the corpus-fed instance popups distinguish themselves from the
    accent-colored schema-fed popups (kind and property) by the page
    background colors (with a border setting them off the page), both
    colored through the dedicated title path and description tokens
    --theme-color-specbook-popup-{schema,spec}-{path,desc}  */
div.info-popup
    display: none
    position: fixed
    z-index: 40
    box-sizing: border-box
    max-width: 40vw
    padding: 0.65rem 1.0rem
    border-radius: 0.25rem
    color: var(--theme-color-specbook-popup-schema-desc)
    background-color: var(--theme-color-specbook-accent)
    box-shadow: 0 0.2rem 0.8rem rgba(0, 0, 0, 0.4)
    pointer-events: none
div.info-popup.open
    display: block
div.info-popup.spec
    color: var(--theme-color-specbook-popup-spec-desc)
    background-color: var(--theme-color-specbook-background)
    border: 1px solid var(--theme-color-specbook-border)
div.info-popup div.info-title
    color: var(--theme-color-specbook-popup-schema-path)
div.info-popup.spec div.info-title
    color: var(--theme-color-specbook-popup-spec-path)
div.info-popup span.info-kind,
div.info-popup span.info-property
    font-weight: bold
div.info-popup span.info-name
    color: var(--theme-color-specbook-popup-schema-desc)
    font-weight: 600
div.info-popup.spec span.info-name
    color: var(--theme-color-specbook-popup-spec-desc)
div.info-popup span.info-object::before
    content: "\25CF"
    font-weight: normal
    font-size: 120%
    margin-right: 0.25rem
    vertical-align: -0.075em
    line-height: 0
div.info-popup span.info-property::before
    content: "\25CB"
    font-weight: normal
    font-size: 120%
    margin-right: 0.25rem
    vertical-align: -0.075em
    line-height: 0
div.info-popup div.info-desc p
    margin: 0.25rem 0
div.info-popup div.info-desc p:last-child
    margin-bottom: 0

/*  the origin label of a description: its prefix word in normal
    weight in a borderless rounded box filled with the title path
    color (the word itself in the popup background color)  */
div.info-popup span.info-origin
    display: inline-block
    padding: 0.05rem 0.45rem
    border-radius: 0.25rem
    margin-right: 0.25rem
    font-weight: normal
    color: var(--theme-color-specbook-accent)
    background-color: var(--theme-color-specbook-popup-schema-path)
div.info-popup.spec span.info-origin
    color: var(--theme-color-specbook-background)
    background-color: var(--theme-color-specbook-popup-spec-path)

/*  the pointer separating the title path segments (objects and the
    property), lowered so the triangle (designed above the baseline)
    centers optically on the x-height of the text  */
div.info-popup span.info-pointer
    margin: 0 0.35rem
    font-weight: normal
    vertical-align: -0.1em
    line-height: 0

/*  the hyperlinks of a description inside an accent-colored popup
    inherit the popup foreground, as their accent link color (and the
    accent icon of the compact form) would vanish on the accent
    background (the links are inert anyway, as the popup ignores
    pointer events), while inside the page-background instance popups
    they render as in the content: plain links accent, compact link
    names in the popup text color with the icon staying accent  */
div.info-popup a,
div.info-popup a.link-compact::before
    color: var(--theme-color-specbook-popup-schema-desc)
div.info-popup.spec a
    color: var(--theme-color-specbook-accent)
div.info-popup.spec a.link-compact
    color: var(--theme-color-specbook-popup-spec-desc)
div.info-popup.spec a.link-compact::before
    color: var(--theme-color-specbook-accent)
@media print
    div.info-popup
        display: none

/*  the folding tab (screen-only): the tab riding right of the brand
    bar between the search tab and the table of contents tab (as wide
    as those, fixed independent of the content scrolling), showing a
    fold icon (drawn like the search icon), which slides the two
    controls out to the right (and back in), where the tab follows the
    bar when the table of contents panel shifts it aside; the controls
    fold and unfold all diagrams and all over-long cell texts of the
    content at once and carry, like the fold icon itself, the mark
    colors in a rounded box while anything of their kind is folded  */
div.fold-switch
    position: fixed
    top: 10.66rem
    left: calc(0.6rem - 1px)
    z-index: 30
    display: flex
    align-items: center
    border-radius: 0 0.3rem 0.3rem 0
    color: var(--theme-color-specbook-background)
    background-color: var(--theme-color-specbook-accent)
    transition: left 0.3s ease
body:has(nav.toc-panel.open) div.fold-switch
    left: calc(31rem - 1px)
    box-shadow: 0.2rem 0 0.6rem rgba(0, 0, 0, 0.3)
div.fold-switch div.fold-toggle
    padding: 0.65rem 0.1rem
    line-height: 0
    border-radius: 0 0.3rem 0.3rem 0
    cursor: pointer
div.fold-switch div.fold-toggle:hover
    background-color: var(--theme-color-specbook-accent-soft)
div.fold-switch svg.fold-icon
    width: 1.1rem
    height: 1.1rem
    padding: 0.25rem
    border-radius: 0.3rem
    margin-right: 0.15rem
div.fold-switch.folded svg.fold-icon
    color: var(--theme-color-specbook-mark-text)
    background-color: var(--theme-color-specbook-mark-back)
div.fold-switch div.fold-controls
    display: flex
    align-items: center
    gap: 0.3rem
    overflow: hidden
    max-width: 0
    padding: 0
    transition: max-width 0.3s ease, padding 0.3s ease
div.fold-switch.open div.fold-controls
    max-width: 6rem
    padding: 0 0.5rem 0 0.2rem
div.fold-switch div.fold-controls > div
    padding: 0.25rem
    line-height: 0
    border-radius: 0.3rem
    cursor: pointer
    -webkit-user-select: none
    user-select: none
div.fold-switch div.fold-controls > div:hover
    background-color: var(--theme-color-specbook-accent-soft)
div.fold-switch div.fold-controls > div.folded
    color: var(--theme-color-specbook-mark-text)
    background-color: var(--theme-color-specbook-mark-back)
div.fold-switch div.fold-controls svg
    width: 1.1rem
    height: 1.1rem
@media print
    div.fold-switch
        display: none

/*  the folding of the diagrams and the over-long table cells
    (screen-only): a diagram sits in a fold container carrying a chevron
    mark in the muted symbol color of the anchors at its top left corner
    -- in the page margin beside the content, and in the flow left of
    the diagram inside a table cell, where no margin is left -- while an
    over-long cell carries its own chevron in a rounded grey box behind
    the last still shown word; a folded diagram leaves the icon of its
    tab control behind in the muted color, and a running search unfolds
    everything, so no match hides inside  */
div.fold
    position: relative
span.fold-mark,
span.fold-more
    color: var(--theme-color-specbook-symbol)
    line-height: 0
    cursor: pointer
    -webkit-user-select: none
    user-select: none
span.fold-mark:hover,
span.fold-more:hover
    color: var(--theme-color-specbook-accent)
span.fold-mark
    position: absolute
    top: 0.35rem
    left: -1.15rem
span.fold-more
    display: inline-block
    margin-left: 0.2rem
    padding: 0.1rem 0.25rem
    vertical-align: -0.05em
    border: 1px solid var(--theme-color-specbook-border)
    border-radius: 0.25rem
span.fold-more:hover
    border-color: var(--theme-color-specbook-accent)
span.fold-mark svg,
span.fold-more svg
    width: 0.8rem
    height: 0.8rem
div.fold.folded > span.fold-mark svg,
td.folded span.fold-more svg
    transform: rotate(-90deg)
span.fold-label
    display: none
    line-height: 0
    margin-bottom: 1.0rem
    color: var(--theme-color-specbook-muted)
span.fold-label svg
    width: 1.1rem
    height: 1.1rem
@media screen
    td div.fold > span.fold-mark
        position: static
        display: inline-block
        vertical-align: middle
        margin-right: 0.3rem
    body:not(.searching) div.fold.folded > span.fold-label
        display: block
    body:not(.searching) td div.fold.folded > span.fold-label
        display: inline-block
        vertical-align: middle
        margin-bottom: 0
    body:not(.searching) div.fold.folded > div.diagram,
    body:not(.searching) td.folded .fold-rest
        display: none
@media print
    span.fold-mark,
    span.fold-more
        display: none

/*  the connection status tab of the live preview (screen-only): the
    bottommost tab riding right of the brand bar below the table of
    contents tab (sized like the search tab, fixed independent of the
    content scrolling), showing a plug icon (drawn like the search
    icon), where the tab follows the bar when the
    table of contents panel shifts it aside and the icon carries the
    mark colors in a rounded box (like the search icon while a filter
    is active) while disconnected, plus blinking in a soft accent box
    for 2s (toggling every 250ms) after a content reload  */
div.realtime-status
    position: fixed
    top: 17.12rem
    left: calc(0.6rem - 2px)
    z-index: 30
    padding: 0.65rem 0.1rem
    line-height: 0
    border-radius: 0 0.3rem 0.3rem 0
    color: var(--theme-color-specbook-background)
    background-color: var(--theme-color-specbook-accent)
    transition: left 0.3s ease
    -webkit-user-select: none
    user-select: none
body:has(nav.toc-panel.open) div.realtime-status
    left: calc(31rem - 2px)
    box-shadow: 0.2rem 0 0.6rem rgba(0, 0, 0, 0.3)
div.realtime-status svg.realtime-icon
    width: 1.1rem
    height: 1.1rem
    padding: 0.25rem
    border-radius: 0.3rem
    margin-right: 0.15rem
div.realtime-status.disconnected svg.realtime-icon
    color: var(--theme-color-specbook-mark-text)
    background-color: var(--theme-color-specbook-mark-back)
div.realtime-status.reloaded svg.realtime-icon
    animation: realtime-blink 0.5s step-end 4
@keyframes realtime-blink
    from
        background-color: var(--theme-color-specbook-accent-soft)
    50%
        background-color: transparent
@media print
    div.realtime-status
        display: none

/*  the scroll progress meter (screen-only): a ring at the bottom right
    corner of the viewport (fixed independent of the content scrolling),
    whose DONE part (the arc drawn clockwise from the top, together with
    the upward arrow in its center, drawn like the tab icons) reflects
    the scrolled fraction of the document over the TODO part (the full
    circle in the lighter progress color beneath), which stays hidden
    while the page is scrolled near the top (fading in once scrolled
    beyond 400px) and scrolls the page back to the top on click, where
    the DONE part and the arrow brighten on hover like the tabs  */
div.scroll-progress
    position: fixed
    right: 1.5rem
    bottom: 1.5rem
