/*  the actual, scannable QR code for `site.url`, generated offline (qrcode,
    25x25 modules plus a 4-module quiet zone). The white background rect is
    dropped so the code sits transparent on its surroundings, and the module
    stroke is switched to `currentColor` so it inherits the wrapper's text
    colour. `class` is forwarded to the <svg> for sizing (e.g. "h-16 w-16").  */

import { site } from "../data/site.ts"

interface Props {
    class?: string
}

const { class: className = "h-16 w-16" } = Astro.props
---
<svg
    viewBox="0 0 33 33"
    shape-rendering="crispEdges"
    class={className}
    role="img"
    aria-label={`QR code linking to ${site.url}`}
>
    <path stroke="currentColor" d="M4 4.5h7m2 0h4m1 0h1m1 0h1m1 0h7M4 5.5h1m5 0h1m3 0h2m2 0h2m2 0h1m5 0h1M4 6.5h1m1 0h3m1 0h1m1 0h1m2 0h2m3 0h1m1 0h1m1 0h3m1 0h1M4 7.5h1m1 0h3m1 0h1m1 0h7m3 0h1m1 0h3m1 0h1M4 8.5h1m1 0h3m1 0h1m1 0h2m1 0h1m1 0h1m4 0h1m1 0h3m1 0h1M4 9.5h1m5 0h1m1 0h1m1 0h2m1 0h4m1 0h1m5 0h1M4 10.5h7m1 0h1m1 0h1m1 0h1m1 0h1m1 0h1m1 0h7M12 11.5h1m1 0h2m2 0h1M4 12.5h1m1 0h5m3 0h1m2 0h2m3 0h5M6 13.5h2m5 0h1m1 0h1m1 0h1m2 0h2m1 0h1m3 0h1M4 14.5h3m1 0h1m1 0h11m1 0h4m1 0h2M6 15.5h1m2 0h1m3 0h2m1 0h1m1 0h1m1 0h1m1 0h1m5 0h1M6 16.5h3m1 0h6m1 0h2m2 0h4m1 0h3M4 17.5h1m4 0h1m4 0h1m1 0h2m2 0h1m2 0h1m1 0h1m1 0h1M4 18.5h1m1 0h1m3 0h4m4 0h8m1 0h2M4 19.5h1m1 0h1m1 0h2m2 0h3m1 0h1m3 0h5m3 0h1M4 20.5h1m1 0h5m2 0h2m1 0h3m1 0h5m1 0h1M12 21.5h3m3 0h3m3 0h2M4 22.5h7m4 0h3m2 0h1m1 0h1m1 0h1m1 0h3M4 23.5h1m5 0h1m1 0h1m1 0h2m2 0h1m1 0h1m3 0h2M4 24.5h1m1 0h3m1 0h1m1 0h2m1 0h1m3 0h6m1 0h3M4 25.5h1m1 0h3m1 0h1m1 0h2m2 0h2m1 0h4m1 0h5M4 26.5h1m1 0h3m1 0h1m1 0h1m4 0h3m5 0h2m1 0h1M4 27.5h1m5 0h1m2 0h1m2 0h2m1 0h2m1 0h4m2 0h1M4 28.5h7m1 0h2m2 0h1m1 0h1m2 0h1m1 0h6"/>
