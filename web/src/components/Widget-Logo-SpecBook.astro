    </g>
</svg>

<style is:global>
    /*  the two logo inks out of the brand scale: the deep ink carries the
        weight, the light ink the contrast, both legible on the white ground.  */
    .sb-logo .sb-logo-deep  { fill: var(--brand-800); }
    .sb-logo .sb-logo-light { fill: var(--brand-500); }
</style>
