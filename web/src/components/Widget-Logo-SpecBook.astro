/*  inlined SpecBook logo (the open book plus the "SpecBook" wordmark), so its
    two inks come from the CSS brand tokens: the inner book halves and the
    "Spec" lettering take the deep brand ink, the outer covers and the "Book"
    lettering the lighter brand ink. Inlined (not an <img>) so both follow the
    brand scale. `class` is forwarded to the <svg> for sizing/spacing.  */

interface Props {
    class?: string
}

const { class: className = "" } = Astro.props
---
<svg
    class={`sb-logo ${className}`}
    viewBox="0 0 260.8 110.5"
    role="img"
    aria-label="SpecBook logo"
    xmlns="http://www.w3.org/2000/svg"
>
    {/*  the "Spec" wordmark and the two inner book covers — the deep ink  */}
    <g class="sb-logo-deep">
        <path d="M132.6,41.3c2.6,1.3,6.7,2.7,10.8,2.7s6.8-1.9,6.8-4.7-2-4.2-7.2-6c-7.2-2.6-11.9-6.5-11.9-12.8s6.2-12.9,16.3-12.9,8.4,1,11,2.2l-2.2,7.8c-1.7-.8-4.8-2-9-2s-6.3,2-6.3,4.2,2.4,4,8,6.1c7.6,2.8,11.1,6.8,11.1,12.9s-5.5,13.4-17.3,13.4-9.8-1.3-12.2-2.7l2-8Z"/>
