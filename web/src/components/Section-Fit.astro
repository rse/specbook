/*  "Fit Check" section: the blunt, two-column self-qualification panel,
    which lets an unsuitable visitor disqualify themselves before
    investing any more time.  */

import SectionGlow             from "./Section-Glow.astro"
import Annotation              from "./Widget-Annotation.astro"
import { fitFor, fitAgainst }  from "../data/fit.ts"
---
<section id="fit" class="relative isolate mx-auto max-w-4xl px-6 py-8">
    <SectionGlow variant="section" side="left"/>

    {/*  the top margin keeps the heading's Annotation clear of the fixed
         header when the section is reached through its "#fit" anchor  */}
    <header class="mt-12 sb-section-head" data-reveal>
        <h2 class="sb-h2 relative inline-block">
            <Annotation flat class="right-0 translate-x-1/4">
                Better to know now<br/>
                than after installing!
            </Annotation>
            Check Your <span class="text-accent">Fit</span>
        </h2>
        <p class="sb-lead sb-justify">
            <b>SpecBook</b> is deliberately opinionated, so it fits some
            projects well and others not at all. Rather than letting you find
            that out after the installation, here it is up-front — read both
            columns and decide before you spend more time.
        </p>
    </header>

    <div class="mt-12 grid gap-2 lg:grid-cols-2">
        {/*  "for you" column — reveals from the left edge
            ("right" starts off-screen left, per Scroll-Reveal's inverted naming)  */}
        <div class="bg-background-elevated overflow-hidden rounded-xl border border-border-strong shadow-xl" data-reveal="right">
            <h3 class="border-b border-border-strong bg-accent/20 px-4 py-2 text-lg font-semibold text-accent sm:px-6">
                <b>SpecBook</b> is for YOU, if &hellip;
            </h3>
            <ul class="flex flex-col gap-3 p-4 text-sm sm:p-6">
                {fitFor.map((entry) => {
                    /*  bind to a capitalized name so the expression below is
                        recognized as a component and not as an HTML element  */
                    const Icon = entry.icon
                    return (
                        <li>
                            {/*  "mt-0.5" centers the 1rem icon on the 1.25rem
                                 line box of the first title line, so a title
                                 wrapping to two lines keeps the icon on top  */}
                            <div class="flex items-start gap-2">
                                {Icon && <Icon class="mt-0.5 h-4 w-4 shrink-0 text-accent" stroke-width={0.75}/>}
                                <b class="text-accent uppercase">{entry.title}</b>
                            </div>
                            {/*  hanging indent of icon width plus gap, so the
                                 body aligns with the title instead of the icon  */}
                            <p class="text-foreground sb-justify pl-6" set:html={entry.body}/>
                        </li>
                    )
                })}
            </ul>
        </div>

        {/*  "not for you" column — reveals from the right edge
            ("left" starts off-screen right, per Scroll-Reveal's inverted naming)  */}
        <div class="bg-background-elevated overflow-hidden rounded-xl border border-border-strong shadow-xl" data-reveal="left">
            <h3 class="border-b border-border-strong bg-accent/20 px-4 py-2 text-lg font-semibold text-foreground-muted sm:px-6">
                <b>SpecBook</b> is <u>not</u> for YOU, if &hellip;
            </h3>
            <ul class="flex flex-col gap-3 p-4 text-sm sm:p-6">
                {/*  same icon/title/body layout as the "for you" column above,
                     only in the muted palette of this column  */}
                {fitAgainst.map((entry) => {
                    const Icon = entry.icon
                    return (
                        <li>
                            <div class="flex items-start gap-2">
                                {Icon && <Icon class="mt-0.5 h-4 w-4 shrink-0 text-foreground-muted" stroke-width={0.75}/>}
                                <b class="text-foreground-muted uppercase">{entry.title}</b>
                            </div>
                            <p class="text-foreground-secondary sb-justify pl-6" set:html={entry.body}/>
                        </li>
                    )
                })}
            </ul>
        </div>
    </div>
</section>
