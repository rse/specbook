/*  "Fit Check" section: the blunt, two-column self-qualification panel,
    followed by the three-way comparison table. It sits directly below the Hero
    so an unsuitable visitor can disqualify themselves before investing any
    time.  */

import SectionGlow             from "./Section-Glow.astro"
import Annotation              from "./Widget-Annotation.astro"
import { fitFor, fitAgainst }  from "../data/fit.ts"
import { comparison }          from "../data/comparison.ts"

/*  the three comparison-table column icons, staging the same progression the
    columns themselves describe: bound document, free-form text, checked model  */

import FileType                from "@lucide/astro/icons/file-type"
import FileText                from "@lucide/astro/icons/file-text"
import BookCheck               from "@lucide/astro/icons/book-check"

/*  render lightweight inline markup in the comparison cells: turn "**...**"
    into <b>...</b>, "*...*" into <i>...</i>, and "`...`" into <code>...</code>.
    The "**" pass runs first so the single-asterisk pass never consumes a bold
    marker.  */
const inline = (text: string) => text
    .replace(/\*\*(.+?)\*\*/g, "<b>$1</b>")
    .replace(/\*(.+?)\*/g,     "<i>$1</i>")
    .replace(/`(.+?)`/g,       "<code>$1</code>")
---
<section id="fit" class="relative isolate mx-auto max-w-4xl px-6 py-8">
    <SectionGlow variant="section" side="left"/>

    {/*  the top margin keeps the heading's Annotation clear of the fixed
         header when the section is reached through its "#fit" anchor  */}
    <header class="mt-12 sb-section-head" data-reveal>
        <h2 class="sb-h2 relative inline-block">
            <Annotation flat class="right-0 translate-x-1/4">
                Better to know now<br/>
                than after installing!
            </Annotation>
            Check Your <span class="text-accent">Fit</span> First
        </h2>
        <p class="sb-lead sb-justify">
            <b>SpecBook</b> is deliberately opinionated, so it fits some
            projects well and others not at all. Rather than letting you find
            that out after the installation, here it is up-front — read both
            columns and decide before you spend more time.
        </p>
    </header>

    <div class="mt-12 grid gap-2 lg:grid-cols-2">
        {/*  "for you" column — reveals from the left edge
            ("right" starts off-screen left, per Scroll-Reveal's inverted naming)  */}
        <div class="bg-background-elevated overflow-hidden rounded-xl border border-border-strong shadow-xl" data-reveal="right">
            <h3 class="border-b border-border-strong bg-accent/20 px-4 py-2 text-lg font-semibold text-accent sm:px-6">
                <b>SpecBook</b> is for YOU, if &hellip;
            </h3>
            <ul class="flex flex-col gap-3 p-4 text-sm sm:p-6">
                {fitFor.map((entry) => {
                    /*  bind to a capitalized name so the expression below is
                        recognized as a component and not as an HTML element  */
                    const Icon = entry.icon
                    return (
                        <li>
                            {/*  "mt-0.5" centers the 1rem icon on the 1.25rem
                                 line box of the first title line, so a title
                                 wrapping to two lines keeps the icon on top  */}
                            <div class="flex items-start gap-2">
                                {Icon && <Icon class="mt-0.5 h-4 w-4 shrink-0 text-accent" stroke-width={0.75}/>}
                                <b class="text-accent uppercase">{entry.title}</b>
                            </div>
                            {/*  hanging indent of icon width plus gap, so the
                                 body aligns with the title instead of the icon  */}
                            <p class="text-foreground sb-justify pl-6" set:html={entry.body}/>
                        </li>
                    )
                })}
            </ul>
        </div>

        {/*  "not for you" column — reveals from the right edge
            ("left" starts off-screen right, per Scroll-Reveal's inverted naming)  */}
        <div class="bg-background-elevated overflow-hidden rounded-xl border border-border-strong shadow-xl" data-reveal="left">
            <h3 class="border-b border-border-strong bg-accent/20 px-4 py-2 text-lg font-semibold text-foreground-muted sm:px-6">
                <b>SpecBook</b> is <u>not</u> for YOU, if &hellip;
            </h3>
            <ul class="flex flex-col gap-3 p-4 text-sm sm:p-6">
                {/*  same icon/title/body layout as the "for you" column above,
                     only in the muted palette of this column  */}
                {fitAgainst.map((entry) => {
                    const Icon = entry.icon
                    return (
                        <li>
                            <div class="flex items-start gap-2">
                                {Icon && <Icon class="mt-0.5 h-4 w-4 shrink-0 text-foreground-muted" stroke-width={0.75}/>}
                                <b class="text-foreground-muted uppercase">{entry.title}</b>
                            </div>
                            <p class="text-foreground-secondary sb-justify pl-6" set:html={entry.body}/>
                        </li>
                    )
                })}
            </ul>
        </div>
    </div>

    <div class="relative">
        <SectionGlow variant="section" side="right" />
        <header class="mt-24 sb-section-head" data-reveal>
            <h2 class="sb-h2 relative inline-block">
                <Annotation flat class="right-0 translate-x-2/4">
                    Same work-step,<br/>
                    three different worlds!
                </Annotation>
                See the <span class="text-accent">Practical Difference</span>
            </h2>
            <p class="mt-4 text-foreground-secondary sb-justify">
                Markdown alone is already fantastic for a specification, but it
                leaves every structural rule to discipline. Some recurring
                work-steps, done three ways: in a classic office document, in
                plain unconstrained Markdown, and in <b>SpecBook</b> format.
            </p>
        </header>

        <div class="bg-background-elevated mt-6 overflow-hidden rounded-xl border border-border-strong p-3 shadow-xl sm:p-4" data-reveal>
            <table class="sb-compat-table w-full text-left text-xs sm:text-sm">
                <thead>
                    {/*  the icon sits on its own flex line, which makes the
                         following <i> subtitle start a new line by itself  */}
                    <tr class="border-b border-border-strong text-accent">
                        <th class="pb-2 pr-1 font-semibold sm:pr-2"></th>
                        <th class="pb-2 px-1 font-semibold sm:px-2">
                            <span class="flex items-center gap-1.5"><FileType class="h-4 w-4 shrink-0" stroke-width={0.75}/>Office Document</span>
                        </th>
                        <th class="pb-2 px-1 font-semibold sm:px-2">
                            <span class="flex items-center gap-1.5"><FileText class="h-4 w-4 shrink-0" stroke-width={0.75}/>Plain Markdown</span>
                        </th>
                        <th class="pb-2 pl-1 font-semibold sm:pl-2">
                            <span class="flex items-center gap-1.5"><BookCheck class="h-4 w-4 shrink-0" stroke-width={0.75}/>SpecBook Format</span>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    {comparison.map((row) => (
                        <tr class="border-b border-border-strong last:border-0">
                            <td class="py-1 pr-1 align-top font-bold text-accent     sm:pr-2" set:html={inline(row.topic)} />
                            <td class="py-1 px-1 align-top text-foreground-muted     sm:px-2" data-label="Office Document:" set:html={inline(row.office)} />
                            <td class="py-1 px-1 align-top text-foreground-secondary sm:px-2" data-label="Plain Markdown:"  set:html={inline(row.markdown)} />
                            <td class="py-1 pl-1 align-top text-foreground           sm:pl-2" data-label="SpecBook:"        set:html={inline(row.specbook)} />
                        </tr>
                    ))}
                </tbody>
            </table>
        </div>
    </div>
</section>

<style>
    /*  on small screens, collapse the multi-column comparison table into a
        single-column, stacked-card layout: the header row is hidden, each
        row becomes a card, the topic cell its heading, and every data cell
        a labelled line prefixed by its column name via the "data-label"
        attribute. above the "sm" breakpoint the native table layout applies.  */
    @media (max-width: 639px) {
        .sb-compat-table,
        .sb-compat-table tbody,
        .sb-compat-table tr,
        .sb-compat-table td {
            display: block;
            width: 100%;
        }
        .sb-compat-table thead {
            display: none;
        }
        .sb-compat-table tr {
            padding: 0.75rem 0;
        }
        .sb-compat-table td {
            padding-left: 0;
            padding-right: 0;
        }
        .sb-compat-table td:first-child {
            margin-bottom: 0.375rem;
            font-size: 0.875rem;
        }
        .sb-compat-table td[data-label]::before {
            content: attr(data-label);
            display: block;
            font-weight: 600;
            font-style: italic;
            color: var(--color-accent);
        }
        .sb-compat-table td[data-label] {
            margin-top: 0.375rem;
        }
    }
</style>
