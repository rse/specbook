/*  "Architecture" section: an overview paragraph plus one text/figure row
    describing the API / CLI / MCP building blocks and the two parsing phases.  */

import SectionGlow from "./Section-Glow.astro"
import Annotation  from "./Widget-Annotation.astro"
import Blocks      from "@lucide/astro/icons/blocks"
import Layers      from "@lucide/astro/icons/layers"

/*  the two parsing phases the corpus passes through before any export  */
const phases = [
    { name: "Syntactic Phase",
      body: "The Markdown of every referenced artifact file is turned into the <code>Spec</code> " +
            "Abstract Syntax Tree: headings become objects, property lists become properties, " +
            "and the prose becomes descriptions." },
    { name: "Semantic Phase",
      body: "The AST is validated against the schema configuration: property values against the " +
            "expression language, the uniqueness and presence flags among the siblings, the shape " +
            "of the reference-valued properties, the state machines of the automaton kinds, the " +
            "coverage a referenced kind demands, and the resolvability of every reference." }
]

/*  the three interfaces, all thin wrappers over one and the same API class  */
const layers = [
    { name: "API", shape: "SpecBook.<cmd>()",  body: "The facade class every command lives in — the single implementation." },
    { name: "CLI", shape: "specbook <cmd>",    body: "A Commander-based thin wrapper for humans, scripts, and CI pipelines." },
    { name: "MCP", shape: "specbook_<cmd>()",  body: "A Model-Context-Protocol stdio service, exposing the same commands as agent tools." }
]
---
<section id="architecture" class="mt-4 sm:mt-12 relative isolate mx-auto max-w-4xl px-6 py-8">
    <SectionGlow variant="section" side="left" />
    <header class="sb-section-head" data-reveal>
        <h2 class="sb-h2">
            <Annotation flat class="hidden sm:block right-0 -translate-x-1/2">
                One implementation,<br/>
                three front doors!
            </Annotation>
            Overview of the <span class="text-accent">Architecture</span>
        </h2>
        <p class="sb-lead sb-justify">
            <b>SpecBook</b> implements every command exactly once, in the API
            class <code>SpecBook</code>. The Command-Line Interface and the
            Model-Context-Protocol service are nothing but thin wrappers over
            it — so humans, scripts, and AI agents use literally the same
            functionality.
        </p>
    </header>

    <div class="mt-12 flex flex-col gap-16">
        <div class="sb-grid-split">
            <div class="relative lg:order-1">
                <SectionGlow variant="text" side="left" />
                <div data-reveal="right">
                    <p class="sb-eyebrow">Software Architecture</p>
                    {/*  "mt-1" centers the icon on the first line box of the
                         heading, so a wrapping heading keeps it on top  */}
                    <h3 class="sb-h3 flex items-start gap-2">
                        <Blocks class="mt-1 h-6 w-6 shrink-0 sm:h-7 sm:w-7" stroke-width={0.75}/>
                        API, CLI, MCP
                    </h3>
                    <p class="mt-4 text-foreground-secondary sb-justify">
                        There is no second, weaker code path behind any of the three
                        interfaces. Whatever the CLI can do, the MCP service can do,
                        and whatever both can do, your own script can do by
                        importing the API class directly.
                    </p>
                    <p class="text-foreground-secondary sb-indent-p sb-justify">
                        The one deliberate exception is <code>preview</code>, which
                        is a long-running Fastify HTTP/WebSocket server and hence
                        has no MCP tool of its own.
                    </p>
                </div>
            </div>

            <div class="lg:order-2 flex flex-col gap-2" data-reveal="left">
                {layers.map((layer) => (
                    <div class="overflow-hidden rounded-xl border border-border-strong bg-background-elevated p-4 shadow-xl">
                        <div class="flex flex-wrap items-baseline gap-x-3">
                            <span class="text-lg font-bold text-accent">{layer.name}</span>
                            <code class="code-plain font-mono text-sm text-foreground-muted">{layer.shape}</code>
                        </div>
                        <p class="mt-1 text-sm text-foreground-secondary">{layer.body}</p>
                    </div>
                ))}
            </div>
        </div>

        <div class="sb-grid-split">
            <div class="relative lg:order-2">
                <SectionGlow variant="text" side="right" />
                <div data-reveal="left">
                    <p class="sb-eyebrow">Processing Pipeline</p>
                    <h3 class="sb-h3 flex items-start gap-2">
                        <Layers class="mt-1 h-6 w-6 shrink-0 sm:h-7 sm:w-7" stroke-width={0.75}/>
                        Two Parsing Phases
                    </h3>
                    <p class="mt-4 text-foreground-secondary sb-justify">
                        Parsing is split into a syntactic and a semantic phase, so a
                        structural mistake and a rule violation are reported as two
                        clearly different kinds of diagnostic — each pinned to its
                        exact file and line.
                    </p>
                    <p class="text-foreground-secondary sb-indent-p sb-justify">
                        Only once both phases pass does any renderer run at all,
                        which is why a partial or invalid specification can never
                        reach an output file.
                    </p>
                </div>
            </div>

            <div class="lg:order-1 flex flex-col gap-2" data-reveal="right">
                {phases.map((phase, index) => (
                    <div class="overflow-hidden rounded-xl border border-border-strong bg-background-elevated p-4 shadow-xl">
                        <div class="flex items-baseline gap-3">
                            <span class="font-mono text-sm text-foreground-muted">{index + 1}.</span>
                            <span class="text-lg font-bold text-accent">{phase.name}</span>
                        </div>
                        <p class="mt-1 text-sm text-foreground-secondary sb-justify" set:html={phase.body}/>
                    </div>
                ))}
            </div>
        </div>
    </div>
</section>
