{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": [ "ES2023", "DOM", "DOM.Iterable" ],
        "strict": true,
        "types": [ "node" ],
        "esModuleInterop": true,
        "skipLibCheck": true,
        "declaration": true,
        "outDir": "../dst",
        "rootDir": "../src"
    },
    "include": [ "../src/**/*.ts" ]
}
